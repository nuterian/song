# Virtualenv — ./setup.sh rebuilds it, and it is a gigabyte of torch.
.venv/
__pycache__/
*.py[cod]

.DS_Store

# Aligned tracks. Everything under here is derived from an audio file and a
# lyrics file — isolated stems, playback previews, the analysis payload, the
# scored project and its exports — and runs to tens of megabytes per track.
# Recreate with:  python -m lyricsync <audio> <lyrics>
workdir/

# Source audio: bring your own track. examples/lyrics.txt is kept, so the
# sample lyrics (and the section-header format) are here to read.
examples/*.wav
examples/*.mp3
examples/*.m4a
examples/*.flac
examples/*.aif
examples/*.aiff
examples/*.ogg

# Working notes. NEXT-*.md are plans for work in flight; once it ships the plan
# is wrong on purpose (it describes a "before" that no longer exists) and the
# README and the docs site are the record.
NEXT-*.md
